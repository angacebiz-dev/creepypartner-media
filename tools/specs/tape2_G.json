  {
   "t0": 0.75,
   "t1": 8.39,
   "spk": "DET. COLE",
   "text": "This is Detective Cole, interview room two. Subject was found walking out of Pell Woods at 1 A.M. State your name, please."
  },
  {
   "t0": 8.59,
   "t1": 10.6,
   "spk": "JOHN DOE",
   "text": "I don't remember my name."
  },
  {
   "t0": 10.8,
   "t1": 14.74,
   "spk": "DET. COLE",
   "text": "You had a hiking permit for six people. Where are the other five?"
  },
  {
   "t0": 15.59,
   "t1": 17.33,
   "spk": "JOHN DOE",
   "text": "They're still down there."
  },
  {
   "t0": 17.53,
   "t1": 18.45,
   "spk": "DET. COLE",
   "text": "Down where?"
  },
  {
   "t0": 19.2,
   "t1": 24.5,
   "spk": "JOHN DOE",
   "text": "Under the hill. There's a door in the hill. We thought it was an old mine."
  },
  {
   "t0": 24.7,
   "t1": 26.49,
   "spk": "DET. COLE",
   "text": "And what happened in the mine?"
  },
  {
   "t0": 27.34,
   "t1": 34.28,
   "spk": "JOHN DOE",
   "text": "It wasn't a mine. It was a house. Someone lives down there. He set the table for six."
  },
  {
   "t0": 34.48,
   "t1": 36.93,
   "spk": "DET. COLE",
   "text": "So why did he let you leave?"
  },
  {
   "t0": 38.38,
   "t1": 44.03,
   "spk": "JOHN DOE",
   "text": "He said you'd come looking. He told me to tell you... he's setting the table for seven."
  }
 ],
